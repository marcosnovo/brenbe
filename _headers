# Cloudflare Pages custom headers
# Cloudflare une con comas los Cache-Control de reglas que se superponen: cada ruta cae en una sola regla.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/admin/*
  X-Robots-Tag: noindex, nofollow

# Redirecciones a WhatsApp (medición de clics): nunca indexar.
/wa/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

/brenbe-blocks.js
  Cache-Control: public, max-age=3600, must-revalidate

# Evita que la copia en pages.dev se indexe (el dominio válido es brenbe.com).
# ":project" es un placeholder de Pages: aplica a cualquier *.pages.dev del proyecto.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# CSS/JS: el HTML los enlaza con ?v=<hora del build>, así cada deploy rompe la caché del navegador.
# El nombre de archivo es estable (no se puede dar 1 año: _headers no distingue ?v=), por eso max-age moderado + must-revalidate.
/brenbe.css
  Cache-Control: public, max-age=3600, must-revalidate

/brenbe-lang.js
  Cache-Control: public, max-age=3600, must-revalidate

# Lista de idiomas publicados: la lee la Function de la raíz (functions/index.js). No se indexa.
/locales.json
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

# Imágenes con nombre estable: revalidar tras una semana en vez de cachear un año.
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Fuentes autoalojadas (nombre sin hash): 30 días.
/fonts/*
  Cache-Control: public, max-age=2592000
